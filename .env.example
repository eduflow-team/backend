# === Application ===
PROJECT_NAME=eduflow
API_V1_STR=/api/v1

# === Database ===
POSTGRES_USER=eduflow
POSTGRES_PASSWORD=eduflow
POSTGRES_DB=eduflow
DATABASE_URL=postgresql+asyncpg://eduflow:eduflow@localhost:5432/eduflow

# === Authentication (JWT) ===
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# === CORS ===
BACKEND_CORS_ORIGINS=

# === Signup ===
TEACHER_SIGNUP_CODE=

# === OpenAI (Stage1 임베딩 / Stage2 G-Eval 채점) ===
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=768
OPENAI_CHAT_MODEL=gpt-4o-mini
# Stage1 chunk_size 허용값(코드 상수): 50, 200, 500, 1200, 3000

# === Langflow (Stage1 chat: FLOW_ID+노드 ID 필수, 없으면 503 / Stage2: 미설정 시 mock) ===
# Docker backend 컨테이너에서는 host.docker.internal 사용 (로컬 IDE 실행 시 localhost)
LANGFLOW_URL=http://host.docker.internal:7860
LANGFLOW_API_KEY=
LANGFLOW_STAGE1_CHAT_FLOW_ID=
LANGFLOW_STAGE1_PROMPT_NODE_ID=
LANGFLOW_STAGE1_MODEL_NODE_ID=
LANGFLOW_STAGE2_FLOW_ID=
LANGFLOW_STAGE2_GEN_PROMPT_NODE_ID=
LANGFLOW_STAGE2_EXT_PROMPT_NODE_ID=
LANGFLOW_STAGE3_FLOW_ID=
LANGFLOW_STAGE3_V2_FLOW_ID=
LANGFLOW_STAGE3_PRO_AGENT_ID=LM-s3pro
LANGFLOW_STAGE3_CON_AGENT_ID=LM-s3con
LANGFLOW_STAGE3_FACT_AGENT_ID=LM-s3fact
LANGFLOW_STAGE3_V1_ENDPOINT=stage3-debate
LANGFLOW_STAGE3_V2_ENDPOINT=stage3-debate-v2
# Langflow 미연결 로컬 개발 시에만 true (기본 false → 503)
STAGE3_ALLOW_MOCK=false

# === Langflow (Stage4: 프롬프트 인젝션) ===
LANGFLOW_STAGE4_CHAT_FLOW_ID=
LANGFLOW_STAGE4_PROMPT_NODE_ID=

# Stage1 WEAK 환각 유도 (검색 약할 때 Langflow context만 래핑, UI preview 제외)
# STAGE1_WEAK_MAX_CHARS=350
# STAGE1_WEAK_MAX_SCORE=0.42
# STAGE1_WEAK_CHUNK_SIZE=50
# STAGE1_WEAK_TOP_K=2
# STAGE1_WEAK_NOISE_ENABLED=true
# STAGE1_WEAK_FORCE_HALLUCINATION=true

# Stage 2 생성 컨텍스트 (긴 PDF excerpt 상한, 문자 수)
STAGE2_GENERATION_DOCUMENT_MAX_CHARS=6000
